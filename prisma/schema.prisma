// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  images      String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  total     Float
  items     String   // سنحفظ تفاصيل المنتجات كـ JSON نصي
  createdAt DateTime @default(now())
}